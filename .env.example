# Droptix — contoh variabel lingkungan
# Salin file ini ke .env dan isi nilainya. Jangan commit .env asli.

# Domain publik (untuk produksi HTTPS)
DOMAIN=api.droptix.app

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=droptix
DB_USER=droptix_user
DB_PASSWORD=changeme_ganti_dengan_password_kuat

# JWT
JWT_SECRET=ganti_dengan_secret_panjang_acak_minimal_32_karakter
JWT_EXPIRES_IN=7d

# Backup database terjadwal (hari retensi berkas .sql.gz)
BACKUP_RETENTION_DAYS=7

